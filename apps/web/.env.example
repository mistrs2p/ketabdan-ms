# Local development environment variables for the web app.
# Copy to .env (or .env.local) and adjust values as needed. Do not commit
# real secrets — only this example file is tracked.

# Base URL of the FastAPI backend (docs/01 §4 communication boundary).
# The API client joins paths onto this value, with or without a trailing
# slash. Local development convention: the backend serves on port 8000
# (uvicorn app.main:app --port 8000, see README.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
