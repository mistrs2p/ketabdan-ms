# Local development environment variables for the API.
# Copy to .env and adjust values as needed. Do not commit real secrets.

# ── Environment (Task 5.10; docs/01-ARCHITECTURE.md §11) ─────────────────────
# development | test | production (case-insensitive). Development keeps every
# convenience below; production FAILS CLOSED at startup on insecure
# configuration (placeholder/weak AUTH_SECRET_KEY, missing DATABASE_URL or
# REDIS_URL, wildcard CORS, the insecure-dev flag). Never set production
# without reading docs/01 §11.
APP_ENV=development

# PostgreSQL connection (used by docker-compose.yml too).
# The default host port is 5433 because a native PostgreSQL service on this
# machine may already occupy 5432.
POSTGRES_USER=ketabdaneh
POSTGRES_PASSWORD=ketabdaneh_dev
POSTGRES_DB=ketabdaneh
POSTGRES_PORT=5433

# API
API_HOST=0.0.0.0
API_PORT=8000

# SQLAlchemy database URL (development example — matches docker-compose.yml
# credentials; never commit real credentials)
DATABASE_URL=postgresql+psycopg://ketabdaneh:ketabdaneh_dev@localhost:5433/ketabdaneh

# Authentication (Phase 5; docs/06-BACKEND-API.md §4f)
# Generate a real secret for anything beyond local development, e.g. by
# running secrets.token_urlsafe(48) in a Python REPL.
# The value below matches the code's placeholder default — intentionally
# unsafe, allowed in development only via AUTH_ALLOW_INSECURE_DEV_SECRET=1.
# REQUIRED IN PRODUCTION: real secret of at least 32 characters; the
# placeholder, a short secret, or the flag below are startup errors there.
AUTH_SECRET_KEY=change-me-insecure-dev-placeholder
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 1 = allow the placeholder secret above (local development ONLY).
# Production MUST NOT enable it — that combination is rejected at startup.
AUTH_ALLOW_INSECURE_DEV_SECRET=1

# CORS (Phase 5.3): browser origins allowed to call this API directly.
# Comma-separated http(s) URLs; production sets its real frontend origin(s)
# and must not use "*". Empty disables the CORS middleware entirely.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging (Task 5.8; docs/01-ARCHITECTURE.md §9)
# Root log level for the API and the background worker. Standard Python
# levels only, case-insensitive; any other value is a configuration
# error at startup (never a silent fallback to a different level).
LOG_LEVEL=INFO

# Notifications (Phase 5.6; docs/01-ARCHITECTURE.md §6)
# Bot tokens are secrets: never commit real values. Leave empty to leave a
# provider unconfigured — the application still starts, and that provider
# reports a provider-unavailable failure only if a send is attempted.
# Optional in every environment (including production): the core application
# never requires notification credentials. One provider may be configured
# without the other. Get a token from @BotFather in Telegram / Bale.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
# Bounded network time for one provider request, in seconds.
NOTIFICATION_TIMEOUT_SECONDS=10

# Background notification delivery (Phase 5.7; docs/01-ARCHITECTURE.md §6.5)
# Redis backs the notification job queue (started via docker-compose.yml).
# Like DATABASE_URL, a missing/unreachable Redis never breaks importing or
# starting the API — it only matters when the background-delivery
# infrastructure is used (enqueue) or started (worker).
# REQUIRED IN PRODUCTION: REDIS_URL must be set explicitly (the localhost
# default below is a development convenience).
REDIS_URL=redis://localhost:6390/0
# Bounded retry policy for retryable failures (provider unavailable /
# unexpected errors). Rejected notifications are never retried.
# attempt 1 is immediate; retry n waits base*2^(n-2) seconds (5, 10, 20,
# 40 …), capped at the max delay; after NOTIFICATION_MAX_ATTEMPTS total
# attempts the job fails permanently.
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=5
NOTIFICATION_RETRY_MAX_DELAY_SECONDS=300

# Observability (Task 5.9; docs/01-ARCHITECTURE.md §10)
# The API process always exposes GET /metrics and /api/health/{live,ready}.
# The worker serves no HTTP by default; set a port to expose its Prometheus
# metrics (GET :<port>/metrics) for scraping. 0 disables (default).
WORKER_METRICS_PORT=0
