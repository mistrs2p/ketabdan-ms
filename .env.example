# Ketabdaneh — root environment variables for local development.
# Copy to .env and adjust values as needed. Do not commit real secrets.
# (These drive docker-compose.yml; the API application reads its own
# apps/api/.env — see apps/api/.env.example, including APP_ENV from
# Task 5.10 configuration hardening.)

# PostgreSQL (used by docker-compose.yml).
# The default host port is 5433 because a native PostgreSQL service on this
# machine may already occupy 5432.
POSTGRES_USER=ketabdaneh
POSTGRES_PASSWORD=ketabdaneh_dev
POSTGRES_DB=ketabdaneh
POSTGRES_PORT=5433

# API
API_HOST=0.0.0.0
API_PORT=8000

# SQLAlchemy database URL for the API (development example — matches the
# docker-compose.yml credentials above; never commit real credentials)
DATABASE_URL=postgresql+psycopg://ketabdaneh:ketabdaneh_dev@localhost:5433/ketabdaneh
