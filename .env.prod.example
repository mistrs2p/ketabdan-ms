# Environment file template for the production stack
# (docker-compose.prod.yml — Task 5.12; docs/12-DEPLOYMENT.md).
#
# Copy to .env.prod (git-ignored) and adjust:
#   cp .env.prod.example .env.prod
#   scripts/deploy.sh          # build → migrate → up → verify
#
# ALL values below are FAKE local placeholders — they configure the
# local deployment simulation (docs/12 §16), not a real server. Real
# deployments set a real WEB_DOMAIN, generate real secrets (docs/01
# §11.7; e.g. `openssl rand -hex 32`), mount the default
# deploy/Caddyfile (ACME), and never commit the result. APP_ENV=
# production's fail-closed validation (Task 5.10) enforces the
# AUTH_SECRET_KEY rules at startup.

# ── Public edge (Caddy) ─────────────────────────────────────────────
# The domain the stack is served under. Production: the deployment's
# real DNS name (e.g. ketabdaneh.example.org) pointing at the server;
# Caddy then obtains/renews its certificate automatically (ACME).
# Local simulation: "localhost" (Caddy issues an internal-CA certificate
# — no DNS, no ACME; only fake domains belong here).
WEB_DOMAIN=localhost

# ACME account email (certificate expiry notices). Real address in a
# real deployment; unused by the local simulation Caddyfile.
ACME_EMAIL=

# Which Caddyfile to mount. Default (production): deploy/Caddyfile —
# automatic HTTPS via ACME. Local simulation: deploy/Caddyfile.local —
# Caddy's internal CA, see docs/12 §16.
CADDYFILE=./deploy/Caddyfile.local

# The ONLY host-published ports in the stack (Caddy). Defaults shown.
# HTTP exists for the HTTPS redirect (and ACME HTTP-01 challenges).
HTTP_PUBLISHED_PORT=80
HTTPS_PUBLISHED_PORT=443

# ── Same-origin public URLs (Task 5.12 §5/§7) ───────────────────────
# The browser calls the API SAME-ORIGIN through Caddy: every frontend
# request path already starts with /api/ (apps/web/lib/api), so the base
# URL is simply the site origin — no frontend rewrite. This is public,
# build-time browser configuration baked into the web image; NEVER put a
# secret in NEXT_PUBLIC_* (it is visible to anyone loading the page).
NEXT_PUBLIC_API_BASE_URL=https://localhost

# Browser origins allowed to call the API (Task 5.10: no "*" in
# production). Same-origin requests need no CORS at all; this stays an
# explicit exact origin as defense-in-depth. Must match the site origin.
CORS_ALLOW_ORIGINS=https://localhost

# ── Secrets ─────────────────────────────────────────────────────────
# PostgreSQL (container-internal; no host port is published — only
# Caddy's 80/443 are public).
POSTGRES_USER=ketabdaneh
POSTGRES_PASSWORD=local-fake-not-a-real-password
POSTGRES_DB=ketabdaneh

# JWT signing key — REQUIRED, at least 32 characters, never the
# development placeholder. This fake value is for the local simulation
# only; real deployments generate one (docs/01 §11.7).
AUTH_SECRET_KEY=local-fake-jwt-secret-0123456789abcdef0123456789abcdef

# Notification providers — optional in every environment (Task 5.10).
# Left empty here: the stack starts and runs without contacting
# Telegram/Bale; providers report provider-unavailable only if a send is
# attempted. Do not put real tokens in a committed file.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# ── Optional ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
