# Environment file template for the production-like container stack
# (docker-compose.prod.yml — Task 5.11; docs/01 §12).
#
# Copy to .env.prod (git-ignored) and adjust:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# ALL values below are FAKE local-development placeholders. Real
# deployments generate real secrets (see docs/01 §11.7) and never commit
# them; APP_ENV=production's fail-closed validation (Task 5.10) enforces
# the AUTH_SECRET_KEY rules at startup.

# PostgreSQL (container-internal; no host port is published in this stack).
POSTGRES_USER=ketabdaneh
POSTGRES_PASSWORD=local-fake-not-a-real-password
POSTGRES_DB=ketabdaneh

# JWT signing key — REQUIRED, at least 32 characters, never the
# development placeholder. This fake value is for the local stack only.
AUTH_SECRET_KEY=local-fake-jwt-secret-0123456789abcdef0123456789abcdef

# Browser origins allowed to call the API (Task 5.10: no "*" in
# production). Must match how the browser reaches the web app.
CORS_ALLOW_ORIGINS=http://localhost:3000

# The API origin as the BROWSER reaches it (the browser calls the API
# directly — docs/01 §4). This is public, build-time frontend
# configuration baked into the web image; never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Notification providers — optional in every environment (Task 5.10).
# Left empty here: the stack starts and runs without contacting
# Telegram/Bale; providers report provider-unavailable only if a send is
# attempted. Do not put real tokens in a committed file.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Optional overrides (defaults shown).
LOG_LEVEL=INFO
# Host-published ports (containers always listen on 8000/3000 internally).
API_PUBLISHED_PORT=8000
WEB_PUBLISHED_PORT=3000
